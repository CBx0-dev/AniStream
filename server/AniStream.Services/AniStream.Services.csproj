<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>AniStream</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.*">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>

        <ProjectReference Include="../AniStream.Models/AniStream.Models.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="BuildConfig.cs.template"/>
        <None Include="BuildConfig.cs.template"/>
    </ItemGroup>
    
    <Target Name="GenerateBuildConfig" BeforeTargets="CoreCompile">
        <ReadLinesFromFile File="$(MSBuildProjectDirectory)/BuildConfig.cs.template">
            <Output TaskParameter="Lines" ItemName="_BuildTemplateLines"/>
        </ReadLinesFromFile>

        <PropertyGroup>
            <RequiredClientVersion Condition="'$(RequiredClientVersion)' == ''">0.0.0</RequiredClientVersion>
        </PropertyGroup>

        <PropertyGroup>
            <_GeneratedBuildValues>@(_BuildTemplateLines, '%0A')</_GeneratedBuildValues>
            <_GeneratedBuildValues>$(_GeneratedBuildValues.Replace('__required_client_version__', '$(RequiredClientVersion)'))</_GeneratedBuildValues>
        </PropertyGroup>

        <WriteLinesToFile File="$(IntermediateOutputPath)/BuildConfig.g.cs" Lines="$(_GeneratedBuildValues)" Overwrite="true"/>

        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)/BuildConfig.g.cs"/>
        </ItemGroup>
    </Target>

</Project>
